# Copy this file to .kamal/secrets and export the variables in your shell
# (or a local, git-ignored env file) before running `kamal deploy`.
# .kamal/secrets must never contain real values in git — only the env
# references below belong in the repository.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
PITCAIRN_SESSION_SECRET=$PITCAIRN_SESSION_SECRET
PITCAIRN_BANK_WEBHOOK_SECRET=$PITCAIRN_BANK_WEBHOOK_SECRET
