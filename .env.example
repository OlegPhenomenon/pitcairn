# Pitcairn configuration — copy to .env and adjust. No secret is required to
# start; unset secrets are generated randomly per start (with a warning).
# Never commit a real .env.

# Listen address
PITCAIRN_BIND=127.0.0.1:8080

# Data directory: sqlite db (pitcairn.sqlite3), files/, uploads/, backups/
PITCAIRN_DATA_DIR=./data

# Built SPA directory
PITCAIRN_STATIC_DIR=../frontend/dist

# Public base URL, used for links in mail
PITCAIRN_BASE_URL=http://localhost:8080

# Enables persona switcher, demo mailbox, bank simulator, demo banner
PITCAIRN_DEMO_MODE=false

# Cookie signing secret (random per start if unset)
# PITCAIRN_SESSION_SECRET=

# HMAC secret for bank notification webhook (random per start if unset)
# PITCAIRN_BANK_WEBHOOK_SECRET=

# Max upload size per file, in bytes (2 GiB)
PITCAIRN_MAX_UPLOAD_BYTES=2147483648

# Link checker: mock or http (http blocks private/loopback IPs)
PITCAIRN_LINK_CHECK_MODE=mock

# AI assistant: mock or off
PITCAIRN_AI_MODE=mock

# Set true when served behind TLS
PITCAIRN_SECURE_COOKIES=false
